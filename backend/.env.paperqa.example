# Copy this file to backend/.env.paperqa and replace the key.
# This is for PaperQA/LiteLLM using DeepSeek through an OpenAI-compatible API.

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# LitRadar reads these as fallbacks for PaperQA note generation.
PAPERQA_LLM=openai/deepseek-v4-pro
PAPERQA_SUMMARY_LLM=openai/deepseek-v4-pro

# Keep PaperQA cache/indexes inside the project instead of ~/.pqa.
PQA_HOME=.pqa
